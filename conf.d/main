#!/bin/bash -ex

DB_NAME=orangehrm
DB_USER=orangehrm
DB_PASS=$(mcookie)

ADMIN_NAME=admin
ADMIN_PASS=turnkey12!

SRC=/usr/local/src
WEBROOT=/var/www/orangehrm

# unpack the verified upstream release
unzip "$SRC/orangehrm-5.9.zip" -d "$(dirname "$WEBROOT")"
rm "$(dirname "$WEBROOT")/orangehrm-quick-start-guide.html"
mv "$(dirname "$WEBROOT")/orangehrm-5.9" "$WEBROOT"
rm "$SRC/orangehrm-5.9.zip"


chown -R root:root "$WEBROOT"

# configure apache
a2dissite 000-default
a2ensite orangehrm
a2enmod rewrite

# start services
service mariadb start
service apache2 start

# setup the database
MYSQL_BATCH="mysql --user=root --password=$MYSQL_PASS --batch"
MYSQL_ADMIN="mysqladmin --user=root --password=$MYSQL_PASS"

$MYSQL_ADMIN create $DB_NAME
$MYSQL_BATCH --execute "grant all privileges on $DB_NAME.* to $DB_USER@localhost identified by '$DB_PASS'; flush privileges;"

CONF=$WEBROOT/installer/cli_install_config.yaml
cat >"$CONF" <<EOF
database:
  hostName: 127.0.0.1
  hostPort: 3306
  databaseName: $DB_NAME
  privilegedDatabaseUser: $DB_USER
  privilegedDatabasePassword: $DB_PASS
  useSameDbUserForOrangeHRM: y
  orangehrmDatabaseUser: ~
  orangehrmDatabasePassword: ~
  isExistingDatabase: y
  enableDataEncryption: n

organization:
  name: TurnKeyLinux
  country: US

admin:
  adminUserName: $ADMIN_NAME
  adminPassword: $ADMIN_PASS
  adminEmployeeFirstName: Admin
  adminEmployeeLastName: istrator
  workEmail: admin@example.com
  contactNumber: ~
  registrationConsent: false

license:
  agree: y
EOF

php "$WEBROOT/installer/cli_install.php"

chown -R www-data:www-data \
    "$WEBROOT/lib/confs" "$WEBROOT/src/cache" "$WEBROOT/src/log"

# disable web based installer
cat >$WEBROOT/installer/.htaccess<<EOF
Require all denied
EOF

install -d /usr/share/orangehrm
cat >/usr/share/orangehrm/release <<EOF
version=5.9
url=https://github.com/orangehrm/orangehrm/releases/download/v5.9/orangehrm-5.9.zip
sha256=f6e640f8b59e8d09f15edcd24ac3d42bb52dcc4839a7d83f964dd798bc793f79
EOF

# patch database to avoid potential row issue later
TABLES=$($MYSQL_BATCH --silent $DB_NAME --execute 'SHOW TABLES')
for TABLE in $TABLES; do
    $MYSQL_BATCH $DB_NAME --execute "ALTER TABLE $TABLE ROW_FORMAT=dynamic;"
done

# stop services
service mariadb stop
service apache2 stop
